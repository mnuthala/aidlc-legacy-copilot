  "$comment": "Interchange shape. Controller additionally validates references, scoring, evidence, completeness and readiness.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "type",
      "text",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "source": {
        "type": "string"
      }
    }
  }
}
